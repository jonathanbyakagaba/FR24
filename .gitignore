# What the build writes beside itself. In a CI checkout `fr24_publish` is a symlink to this folder,
# so the flat copies the analysis scripts read and rewrite are scratch: the published copies live in
# the month folders, and `tools/ci_run.py --changed-file` is what says which of them moved.
/fr24_publish
/FR data.zip.bak
/app_status.csv
/data_gaps.md
/date_coverage.md
/fleet_summary.csv
/flight_conditions.csv
/missing_flights.md
/no_code_tracks.md
/punctuality.csv
/punctuality.md
/route_distances.csv
/runway_centreline_fit.csv
/runway_usage.csv
/runway_usage.md
/schedule_delays.csv
/schedule_delays.md
/tails.csv
/weather_analysis.md
/triangle_assignments.csv
/triangle_routes.md
# build state and fetched inputs: re-derivable, and a stale one is worse than none
/fr24_state.json
/work/incoming.zip
/work/ci_capture/
/work/ci_capture.log
/incoming/*
!incoming/.gitkeep
/uploads/*
!uploads/.gitkeep
__pycache__/
*.pyc
/work/awx/
